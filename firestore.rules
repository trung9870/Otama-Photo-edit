rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && (
        (request.auth.token.email == 'trungg9870@gmail.com' && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function hasAppAccess() {
      return signedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canUseClothing == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canUseEcom == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canUseOfa == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canUsePicset == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canUseRunninghub == true
        ))
      );
    }

    function recentTimestamp(ts) {
      return ts is timestamp &&
        ts >= request.time - duration.value(5, 'm') &&
        ts <= request.time + duration.value(5, 'm');
    }

    function optionalShortString(data, key, maxLength) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLength);
    }

    function isDefaultPrompt(data) {
      return 'isDefault' in data && data.isDefault == true;
    }

    function isEncryptedPrompt(data) {
      return data.prompt is string &&
        data.prompt.size() > 35 && data.prompt.size() <= 20000 &&
        data.prompt.matches('^enc:v1:[A-Za-z0-9_-]+$');
    }

    function isSharedAsset(data) {
      return 'isShared' in data && data.isShared == true;
    }

    function validPrompt(data) {
      return data.keys().hasAll(['id', 'name', 'prompt', 'type', 'uid', 'createdAt']) &&
        data.keys().hasOnly(['id', 'name', 'prompt', 'type', 'uid', 'createdAt', 'isDefault']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 100 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.prompt is string && data.prompt.size() > 0 && data.prompt.size() <= 20000 &&
        data.type in ['generate', 'tryon', 'ecom', 'ecom-thay'] &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.createdAt is timestamp &&
        (!('isDefault' in data) || data.isDefault is bool) &&
        (!isDefaultPrompt(data) || isEncryptedPrompt(data));
    }

    function validAsset(data) {
      return data.keys().hasAll(['id', 'imageUrl', 'uid', 'createdAt']) &&
        data.keys().hasOnly(['id', 'imageUrl', 'uid', 'createdAt', 'name', 'isShared']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 100 &&
        data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 1500000 &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.createdAt is timestamp &&
        optionalShortString(data, 'name', 100) &&
        (!('isShared' in data) || data.isShared is bool);
    }

    function validUser(data, userId) {
      return data.keys().hasAll([
          'uid', 'email', 'role', 'canUseClothing', 'canUseEcom',
          'canUseOfa', 'canUsePicset', 'canUseRunninghub', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'email', 'role', 'canUseClothing', 'canUseEcom',
          'canUseOfa', 'canUsePicset', 'canUseRunninghub', 'createdAt',
          'creditLimitEnabled', 'dailyCreditLimit'
        ]) &&
        data.uid == userId &&
        data.email is string && data.email.size() > 3 && data.email.size() <= 254 &&
        data.role in ['admin', 'user'] &&
        data.canUseClothing is bool && data.canUseEcom is bool &&
        data.canUseOfa is bool && data.canUsePicset is bool && data.canUseRunninghub is bool &&
        (!('creditLimitEnabled' in data) || data.creditLimitEnabled is bool) &&
        (!('dailyCreditLimit' in data) || (
          data.dailyCreditLimit is int && data.dailyCreditLimit >= 500 && data.dailyCreditLimit <= 1000000
        )) &&
        data.createdAt is timestamp;
    }

    function validDailyCreditUsage(data, usageId) {
      return data.keys().hasAll(['uid', 'email', 'day', 'usedCredits', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'day', 'usedCredits', 'updatedAt']) &&
        data.uid == request.auth.uid && data.email == request.auth.token.email &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() > 3 && data.email.size() <= 254 &&
        data.day is string && data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        usageId == data.uid + '_' + data.day &&
        data.usedCredits is int && data.usedCredits >= 1 && data.usedCredits <= 100000000 &&
        recentTimestamp(data.updatedAt);
    }

    function creditsPerImage(model, size) {
      return model in ['nano-banana-pro', 'gemini-3-pro-image-preview']
        ? (size == '4k' || size == '4K' ? 24 : 18)
        : model in ['nano-banana-2', 'gemini-3.1-flash-image-preview']
          ? (size == '4k' || size == '4K' ? 18 : (size == '2k' || size == '2K' ? 12 : 8))
          : model == 'gpt-image-2-image-to-image'
            ? (size == '4k' || size == '4K' ? 16 : (size == '2k' || size == '2K' ? 10 : 6))
            : model in ['seedream-4-5-edit', 'seedream-4-5-text-to-image']
              ? (size == '4k' || size == '4K' ? 8 : 7)
              : 0;
    }

    function validUsage(data) {
      return data.keys().hasAll(['type', 'uid', 'email', 'ts']) &&
        data.uid == request.auth.uid &&
        data.email == request.auth.token.email &&
        recentTimestamp(data.ts) &&
        (
          (data.type == 'view' &&
           data.keys().hasOnly(['type', 'view', 'uid', 'email', 'ts']) &&
           data.view is string && data.view.size() > 0 && data.view.size() <= 100) ||
          (data.type == 'gemini_direct' &&
           data.keys().hasOnly(['type', 'feature', 'model', 'count', 'uid', 'email', 'ts']) &&
           data.feature is string && data.feature.size() <= 100 &&
           data.model is string && data.model.size() <= 100 && data.count == 1) ||
          (data.type == 'gen' &&
           data.keys().hasOnly(['type', 'feature', 'model', 'count', 'size', 'credits', 'cost', 'uid', 'email', 'ts']) &&
           data.feature is string && data.feature.size() > 0 && data.feature.size() <= 100 &&
           data.model is string && data.model.size() > 0 && data.model.size() <= 100 &&
           data.size is string && data.size.size() <= 10 &&
           data.count is int && data.count >= 1 && data.count <= 8 &&
           creditsPerImage(data.model, data.size) > 0 &&
           data.credits == creditsPerImage(data.model, data.size) * data.count &&
           data.cost == data.credits * 0.005)
        );
    }

    function validHistory(data) {
      return data.keys().hasAll(['id', 'uid', 'email', 'url', 'ts', 'feature', 'model', 'size']) &&
        data.keys().hasOnly([
          'id', 'uid', 'email', 'url', 'ts', 'feature', 'model', 'size', 'batchId',
          'prompt', 'supplementaryPrompt', 'promptId', 'promptSource', 'inputImage',
          'modelKey', 'aspectRatio', 'imageCount', 't2iMode'
        ]) &&
        data.uid == request.auth.uid && data.email == request.auth.token.email &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 100 &&
        data.url is string && data.url.size() > 0 && data.url.size() <= 900000 &&
        recentTimestamp(data.ts) &&
        data.feature is string && data.feature.size() > 0 && data.feature.size() <= 100 &&
        data.model is string && data.model.size() > 0 && data.model.size() <= 100 &&
        data.size is string && data.size.size() <= 10 &&
        optionalShortString(data, 'batchId', 100) && optionalShortString(data, 'prompt', 20000) &&
        optionalShortString(data, 'supplementaryPrompt', 12000) && optionalShortString(data, 'promptId', 100) &&
        (!('promptSource' in data) || data.promptSource in ['manual', 'saved']) &&
        optionalShortString(data, 'inputImage', 600000) && optionalShortString(data, 'modelKey', 100) &&
        optionalShortString(data, 'aspectRatio', 20) &&
        (!('imageCount' in data) || (data.imageCount is int && data.imageCount >= 1 && data.imageCount <= 8)) &&
        (!('t2iMode' in data) || data.t2iMode is bool);
    }

    match /prompts/{promptId} {
      allow read: if hasAppAccess() && (
        resource.data.uid == request.auth.uid || isAdmin() ||
        (isDefaultPrompt(resource.data) && isEncryptedPrompt(resource.data))
      );
      allow create: if hasAppAccess() && validPrompt(request.resource.data) && (
        isAdmin() || (request.resource.data.uid == request.auth.uid && !isDefaultPrompt(request.resource.data))
      );
      allow update: if hasAppAccess() && validPrompt(request.resource.data) && request.resource.data.uid == resource.data.uid && (
        isAdmin() || (resource.data.uid == request.auth.uid && !isDefaultPrompt(resource.data) && !isDefaultPrompt(request.resource.data))
      );
      allow delete: if hasAppAccess() && (isAdmin() || (resource.data.uid == request.auth.uid && !isDefaultPrompt(resource.data)));
    }

    match /models/{modelId} {
      allow read: if hasAppAccess() && (resource.data.uid == request.auth.uid || isAdmin() || isSharedAsset(resource.data));
      allow create: if hasAppAccess() && validAsset(request.resource.data) && request.resource.data.uid == request.auth.uid &&
        (isAdmin() || !isSharedAsset(request.resource.data));
      allow update: if hasAppAccess() && validAsset(request.resource.data) && request.resource.data.uid == resource.data.uid &&
        (isAdmin() || (resource.data.uid == request.auth.uid && isSharedAsset(request.resource.data) == isSharedAsset(resource.data)));
      allow delete: if hasAppAccess() && (isAdmin() || resource.data.uid == request.auth.uid);
    }

    match /rooms/{roomId} {
      allow read: if hasAppAccess() && (resource.data.uid == request.auth.uid || isAdmin() || isSharedAsset(resource.data));
      allow create: if hasAppAccess() && validAsset(request.resource.data) && request.resource.data.uid == request.auth.uid &&
        (isAdmin() || !isSharedAsset(request.resource.data));
      allow update: if hasAppAccess() && validAsset(request.resource.data) && request.resource.data.uid == resource.data.uid &&
        (isAdmin() || (resource.data.uid == request.auth.uid && isSharedAsset(request.resource.data) == isSharedAsset(resource.data)));
      allow delete: if hasAppAccess() && (isAdmin() || resource.data.uid == request.auth.uid);
    }

    match /usage/{logId} {
      allow read: if isAdmin();
      allow create: if hasAppAccess() && validUsage(request.resource.data);
      allow update, delete: if false;
    }

    match /history/{historyId} {
      allow read: if hasAppAccess() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if hasAppAccess() && validHistory(request.resource.data);
      allow delete: if hasAppAccess() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
    }

    match /dailyCreditUsage/{usageId} {
      allow read: if hasAppAccess() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if hasAppAccess() && validDailyCreditUsage(request.resource.data, usageId);
      allow update: if hasAppAccess() &&
        resource.data.uid == request.auth.uid &&
        validDailyCreditUsage(request.resource.data, usageId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCredits', 'updatedAt']) &&
        request.resource.data.usedCredits > resource.data.usedCredits &&
        request.resource.data.usedCredits - resource.data.usedCredits <= 5000;
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() && validUser(request.resource.data, userId) && request.resource.data.role == 'user';
      allow update: if isAdmin() && validUser(request.resource.data, userId);
      allow delete: if isAdmin() && userId != request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
