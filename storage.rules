rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        (request.auth.token.email == 'trungg9870@gmail.com' && request.auth.token.email_verified == true) ||
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    match /history/{userId}/{fileName} {
      allow get, list: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == userId &&
        request.resource.size > 0 && request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
